# Copy to server/.env for local runs. Every variable is optional; the server validates them at
# start-up and names any bad variable (never its value).

# Gemini API key. Leave empty to run with the deterministic fallbacks only.
GEMINI_API_KEY=

# Port the server listens on.
PORT=8787

# Comma-separated exact origins allowed to call the API from a browser,
# e.g. http://localhost:5173 for the Vite dev server. Not needed when the server hosts the app.
CORS_ORIGINS=

# true only behind exactly one trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Models tried in order; the next one is used only after a 429 or 5xx.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash

# Requests per client per window on the three generative routes.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Gemini calls allowed per hour across all clients; past it, requests get the fallback.
GEMINI_HOURLY_BUDGET=600

# Directory of the built web app to serve from the same origin (e.g. web/dist). Empty: API only.
STATIC_DIR=
